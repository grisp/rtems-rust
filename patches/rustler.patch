 /// Map from `TypeId` to the `NifResourcePtr`. To be able to store this in a `OnceLock`, the
 /// pointer is type-erased and stored as a `usize`.
+#[cfg(not(feature = "nif_crate_isolation"))]
 static mut RESOURCE_TYPES: OnceLock<HashMap<TypeId, usize>> = OnceLock::new();
 
 /// Register an Erlang resource type handle for a particular type given by its `TypeId`
+#[cfg(not(feature = "nif_crate_isolation"))]
 #[allow(static_mut_refs)]
 pub(crate) unsafe fn register_resource_type(type_id: TypeId, resource_type: NifResourcePtr) {
     RESOURCE_TYPES.get_or_init(Default::default);
@@ -21,6 +25,25 @@ pub(crate) unsafe fn register_resource_type(type_id: TypeId, resource_type: NifR
         .insert(type_id, resource_type as usize);
 }
 
+#[cfg(feature = "nif_crate_isolation")]
+static RESOURCE_TYPES: OnceLock<Mutex<HashMap<TypeId, usize>>> = OnceLock::new();
+
+#[cfg(feature = "nif_crate_isolation")]
+pub(crate) unsafe fn register_resource_type(
+    type_id: TypeId,
+    resource_type: NifResourcePtr,
+) -> bool {
+    use std::collections::hash_map::Entry;
+    let mut types = RESOURCE_TYPES.get_or_init(Default::default).lock().unwrap();
+    match types.entry(type_id) {
+        Entry::Vacant(entry) => {
+            entry.insert(resource_type as usize);
+            true
+        }
+        Entry::Occupied(entry) => *entry.get() == resource_type as usize,
+    }
+}
