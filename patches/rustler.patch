+#[derive(Deserialize)]
+struct Metadata {
+    packages: Vec<Package>,
+    resolve: Resolve,
+}
+#[derive(Deserialize)]
+struct Package {
+    id: String,
+    name: String,
+    version: String,
+    source: Option<String>,
+    manifest_path: PathBuf,
+    targets: Vec<Target>,
+    features: BTreeMap<String, Vec<String>>,
+}
+#[derive(Deserialize)]
+struct Target {
+    name: String,
+    kind: Vec<String>,
+}
+#[derive(Deserialize)]
+struct Resolve {
+    root: String,
+    nodes: Vec<Node>,
+}
+#[derive(Deserialize)]
+struct Node {
+    id: String,
+    deps: Vec<Dep>,
+    features: Vec<String>,
+}
+#[derive(Deserialize)]
+struct Dep {
+    pkg: String,
+    dep_kinds: Vec<DepKind>,
+}
+#[derive(Deserialize)]
+struct DepKind {
+    kind: Option<String>,
+}
+
+#[derive(Serialize)]
+struct Bundle {
+    schema: u32,
+    manifest_path: PathBuf,
+    package: &'static str,
+    library: &'static str,
+    ownership_path: PathBuf,
+    archive: Option<PathBuf>,
+    entries: Vec<Entry>,
+    ownership: Vec<Ownership>,
+    workspace_inputs: Vec<PathBuf>,
+}
+#[derive(Serialize)]
+struct Entry {
+    #[serde(skip_serializing_if = "Option::is_none")]
+    input: Option<String>,
+    library: String,
+    init: String,
+}
+#[derive(Debug, Serialize, PartialEq, Eq, PartialOrd, Ord)]
