+fn main() {
+    if let Err(error) = run() {
+        eprintln!("rustler-bundler: {error}");
+        std::process::exit(1);
+    }
+}
+
+fn run() -> Result<()> {
+    let args: Vec<_> = std::env::args().skip(1).collect();
+    if args == ["--version"] {
+        println!("rustler-bundler {} (schema 1)", env!("CARGO_PKG_VERSION"));
+        return Ok(());
+    }
+    if args.len() != 3 || !["prepare", "build"].contains(&args[0].as_str()) || args[1] != "--spec" {
+        return Err(
+            "usage: rustler-bundler <prepare|build> --spec /absolute/path/bundle.json".into(),
+        );
+    }
+    let spec: Spec = serde_json::from_slice(&fs::read(&args[2])?)?;
+    if spec.schema != 1 || !spec.out_dir.is_absolute() {
+        return Err("schema must be 1 and out_dir must be absolute".into());
+    }
+    let roots = discover(&spec)?;
+    let mut bundle = prepare(&spec, &roots)?;
+    if args[0] == "build" && !roots.is_empty() {
+        bundle.archive = Some(build(&spec, &bundle)?);
+    }
+    // Cargo's JSON stream and this result can share one streaming decoder.
+    let mut result = serde_json::to_value(&bundle)?;
+    result["reason"] = "rustler-bundle".into();
+    println!("{}", serde_json::to_string(&result)?);
+    Ok(())
+}
+
+fn quoted(value: &str) -> String {
+    toml::Value::String(value.into()).to_string()
+}
+fn write_changed(path: &Path, data: &str) -> Result<()> {
+    if fs::read_to_string(path).ok().as_deref() != Some(data) {
+        fs::create_dir_all(path.parent().ok_or("output has no parent")?)?;
+        fs::write(path, data)?;
+    }
+    Ok(())
+}
+fn cargo(spec: &Spec) -> Result<Command> {
+    let (program, args) = spec.cargo.split_first().ok_or("cargo command is empty")?;
+    let mut command = Command::new(program);
+    command.args(args).current_dir(&spec.out_dir);
+    Ok(command)
+}
+fn metadata_command(spec: &Spec) -> Result<Command> {
+    let mut command = cargo(spec)?;
+    command.args(["metadata", "--format-version=1"]);
+    if spec.offline {
+        command.arg("--offline");
+    }
+    if let Some(target) = &spec.target {
+        command.args(["--filter-platform", target]);
+    }
+    command.stderr(Stdio::inherit());
+    Ok(command)
+}
+fn read_metadata<T: serde::de::DeserializeOwned>(mut command: Command) -> Result<T> {
+    let output = command.output()?;
+    if !output.status.success() {
+        return Err(format!("cargo metadata failed ({}) for {command:?}", output.status).into());
+    }
+    Ok(serde_json::from_slice(&output.stdout)?)
+}
+fn metadata(spec: &Spec) -> Result<Metadata> {
+    read_metadata(metadata_command(spec)?)
+}
+
+// Discover selected library targets without requiring build-system-specific package logic.
+fn discover(spec: &Spec) -> Result<Vec<Root>> {
+    if !spec.roots.is_empty() {
+        if !spec.inputs.is_empty() {
+            return Err("specify inputs or roots, not both".into());
+        }
+        return Ok(spec.roots.clone());
+    }
+    if spec.inputs.is_empty() {
+        return Err("inputs or roots must not be empty".into());
+    }
+    let mut ids = BTreeSet::new();
+    let mut roots = Vec::new();
+    for input in &spec.inputs {
+        if !ids.insert(&input.id) {
+            return Err(format!("duplicate input id {}", input.id).into());
+        }
+        if !input.manifest_path.is_absolute() {
+            return Err("input manifest_path must be absolute".into());
+        }
+        if input.features.iter().any(|f| f.contains('/')) {
+            return Err("configure unqualified features on each NIF input".into());
+        }
+        let mut command = metadata_command(spec)?;
+        // Discover in the input workspace, including its ancestor Cargo configuration.
+        command
+            .current_dir(
+                input
+                    .manifest_path
+                    .parent()
+                    .ok_or("invalid input manifest path")?,
+            )
+            .args(["--no-deps", "--manifest-path"])
+            .arg(&input.manifest_path);
+        if !input.default_features {
+            command.arg("--no-default-features");
+        }
+        if !input.features.is_empty() {
+            command.arg("--features").arg(input.features.join(","));
+        }
+        let workspace: Workspace = read_metadata(command)?;
+        roots.extend(selected_roots(workspace, input));
+    }
+    Ok(roots)
+}
+fn selected_roots(workspace: Workspace, input: &Input) -> Vec<Root> {
+    let members = workspace
+        .workspace_default_members
+        .unwrap_or(workspace.workspace_members);
+    workspace
+        .packages
+        .into_iter()
+        .filter(|p| members.contains(&p.id))
+        .flat_map(|p| {
+            p.targets
+                .into_iter()
+                .filter(|t| t.kind.iter().any(|k| input.library_types.contains(k)))
+                .map(move |t| Root {
+                    input: Some(input.id.clone()),
+                    manifest_path: p.manifest_path.clone(),
+                    package: p.name.clone(),
+                    library: t.name,
+                    features: input.features.clone(),
+                    default_features: input.default_features,
+                })
+        })
+        .collect()
+}
+fn library(target: &Target) -> bool {
+    target
+        .kind
+        .iter()
+        .any(|kind| ["lib", "rlib", "staticlib", "cdylib"].contains(&kind.as_str()))
+}
+fn key(package: &Package, target: &Target) -> String {
+    format!("{}@{}", target.name.replace('-', "_"), package.version)
+}
+fn graph(meta: &Metadata) -> BTreeMap<String, Vec<String>> {
+    let libs: BTreeSet<_> = meta
+        .packages
+        .iter()
+        .filter(|p| p.targets.iter().any(library))
+        .map(|p| &p.id)
+        .collect();
+    meta.resolve
+        .nodes
+        .iter()
+        .map(|node| {
+            (
+                node.id.clone(),
+                node.deps
+                    .iter()
+                    .filter(|dep| {
+                        libs.contains(&dep.pkg) && dep.dep_kinds.iter().any(|k| k.kind.is_none())
+                    })
+                    .map(|dep| dep.pkg.clone())
+                    .collect(),
+            )
+        })
+        .collect()
+}
+fn reachable(
+    root: &str,
+    roots: &BTreeSet<String>,
+    graph: &BTreeMap<String, Vec<String>>,
+) -> BTreeSet<String> {
+    let mut seen = BTreeSet::new();
+    let mut todo = vec![root.to_owned()];
+    while let Some(id) = todo.pop() {
+        if (id != root && roots.contains(&id)) || !seen.insert(id.clone()) {
+            continue;
+        }
+        todo.extend(graph.get(&id).into_iter().flatten().cloned());
+    }
+    seen
+}
+fn rustler<'a>(meta: &'a Metadata) -> Result<&'a Package> {
+    let ids = reachable(&meta.resolve.root, &BTreeSet::new(), &graph(meta));
+    let packages: Vec<_> = meta
+        .packages
+        .iter()
+        .filter(|p| p.name == "rustler" && ids.contains(&p.id))
+        .collect();
+    if packages.len() != 1 {
+        return Err(format!(
+            "bundle requires exactly one Rustler runtime; found {}",
+            packages.len()
+        )
+        .into());
+    }
+    let package = packages[0];
+    if !package.features.contains_key("nif_crate_isolation") {
+        return Err(format!(
+            "Rustler {} does not support nif_crate_isolation",
+            package.version
+        )
+        .into());
+    }
+    Ok(package)
+}
+
+// Preserve Cargo's source identity, including a git reference's kind and value.
+fn rustler_dependency(package: &Package) -> Result<(String, String)> {
+    let mut dependency = format!("\n[dependencies.rustler_runtime]\npackage = \"rustler\"\nversion = {}\ndefault-features = false\nfeatures = [\"nif_crate_isolation\"]\n", quoted(&format!("={}", package.version)));
+    let mut config = String::new();
+    match package.source.as_deref() {
+        None => dependency.push_str(&format!(
+            "path = {}\n",
+            quoted(
+                package
+                    .manifest_path
+                    .parent()
+                    .ok_or("invalid Rustler manifest")?
+                    .to_str()
+                    .ok_or("non UTF-8 path")?
+            )
+        )),
+        Some("registry+https://github.com/rust-lang/crates.io-index") => {}
+        Some(source) if source.starts_with("registry+") => {
+            dependency.push_str("registry = \"rustler_bundle_registry\"\n");
+            config = format!(
+                "[registries.rustler_bundle_registry]\nindex = {}\n",
+                quoted(&source[9..])
+            );
+        }
+        Some(source) if source.starts_with("git+") => {
+            let location = source[4..].split('#').next().unwrap();
+            let (url, query) = location.split_once('?').unwrap_or((location, ""));
+            dependency.push_str(&format!("git = {}\n", quoted(url)));
+            for pair in query.split('&').filter(|p| !p.is_empty()) {
+                let (name, value) = pair.split_once('=').ok_or("invalid git reference")?;
+                if !["branch", "tag", "rev"].contains(&name) {
+                    return Err("unsupported git reference".into());
+                }
+                dependency.push_str(&format!("{name} = {}\n", quoted(&decode_query(value)?)));
+            }
+        }
+        Some(source) => return Err(format!("unsupported Rustler source: {source}").into()),
+    }
+    Ok((dependency, config))
+}
+fn decode_query(value: &str) -> Result<String> {
+    let mut decoded = Vec::new();
+    let mut bytes = value.bytes();
+    while let Some(byte) = bytes.next() {
+        decoded.push(match byte {
+            b'+' => b' ',
+            b'%' => {
+                let hex = [
+                    bytes.next().ok_or("invalid URL escape")?,
+                    bytes.next().ok_or("invalid URL escape")?,
+                ];
+                u8::from_str_radix(std::str::from_utf8(&hex)?, 16)?
+            }
+            other => other,
+        });
+    }
+    Ok(String::from_utf8(decoded)?)
+}
+
+fn ownership(meta: &Metadata, roots: &[Root]) -> Result<Vec<Ownership>> {
+    let graph = graph(meta);
+    let mut entries = BTreeMap::new();
+    for root in roots {
+        let matches: Vec<_> = meta
+            .packages
+            .iter()
+            .filter(|p| p.name == root.package && p.manifest_path == root.manifest_path)
+            .flat_map(|p| {
+                p.targets
+                    .iter()
+                    .filter(move |t| t.name == root.library && library(t))
+                    .map(move |t| (p, t))
+            })
+            .collect();
+        if matches.len() != 1 {
+            return Err(format!(
+                "cannot resolve NIF library {} from {}",
+                root.library,
+                root.manifest_path.display()
+            )
+            .into());
+        }
+        let (package, target) = matches[0];
+        if !target
+            .kind
+            .iter()
+            .any(|k| ["lib", "rlib"].contains(&k.as_str()))
+        {
+            return Err(format!("NIF library {} requires lib or rlib output", root.library).into());
+        }
+        entries.insert(package.id.clone(), key(package, target));
+    }
+    let root_ids = entries.keys().cloned().collect();
+    let all_ids: BTreeSet<_> = entries
+        .keys()
+        .flat_map(|id| reachable(id, &BTreeSet::new(), &graph))
+        .collect();
+    let mut identities = BTreeMap::new();
+    for package in meta.packages.iter().filter(|p| all_ids.contains(&p.id)) {
+        for target in package.targets.iter().filter(|t| library(t)) {
+            if let Some(previous) = identities.insert(key(package, target), &package.id) {
+                if previous != &package.id {
+                    return Err(format!("ambiguous crate identity {}", key(package, target)).into());
+                }
+            }
+        }
+    }
+    let mut pairs = BTreeSet::new();
+    for (id, owner) in entries {
+        let ids = reachable(&id, &root_ids, &graph);
+        for package in meta
+            .packages
+            .iter()
+            .filter(|p| ids.contains(&p.id) && p.id != id)
+        {
+            for target in package.targets.iter().filter(|t| library(t)) {
+                pairs.insert(Ownership {
+                    source: key(package, target),
+                    owner: owner.clone(),
+                });
+            }
+        }
+    }
+    Ok(pairs.into_iter().collect())
+}
+
+fn prepare(spec: &Spec, roots: &[Root]) -> Result<Bundle> {
+    let mut bundle = Bundle {
+        schema: 1,
+        manifest_path: spec.out_dir.join("Cargo.toml"),
+        ownership_path: spec.out_dir.join("src/ownership.rs"),
+        package: "rustler_nif_bundle",
+        library: "rustler_nif_bundle",
+        archive: None,
+        entries: Vec::new(),
+        ownership: Vec::new(),
+        workspace_inputs: Vec::new(),
+    };
+    if roots.is_empty() {
+        return Ok(bundle);
+    }
+    fs::create_dir_all(&spec.out_dir)?;
+    let policy = workspace::Policy::load(spec, roots)?;
+    let mut names = BTreeSet::new();
+    let mut manifest = "# Generated by rustler-bundler; do not edit.\n[package]\nname = \"rustler_nif_bundle\"\nversion = \"0.0.0\"\nedition = \"2021\"\n[lib]\ncrate-type = [\"staticlib\"]\n".to_owned();
+    if !policy.has_workspace() { manifest.push_str("\n[workspace]\n"); }
+    // Workspace policy precedes [package] so cargo-features remains a root key.
+    manifest = policy.manifest()? + &manifest;
+    let mut source = String::new();
+    for (index, root) in roots.iter().enumerate() {
+        if !root.manifest_path.is_absolute() {
+            return Err("root manifest_path must be absolute".into());
+        }
+        if !names.insert(root.library.replace('-', "_")) {
+            return Err("NIF library names must be unique".into());
+        }
+        if root.features.iter().any(|f| f.contains('/')) {
+            return Err("configure unqualified features on each NIF root".into());
+        }
+        let dir = root
+            .manifest_path
+            .parent()
+            .ok_or("invalid NIF manifest path")?
+            .to_str()
+            .ok_or("non UTF-8 path")?;
+        manifest.push_str(&format!("\n[dependencies.nif_{index}]\npackage = {}\npath = {}\ndefault-features = {}\nfeatures = [{}]\n",
+            quoted(&root.package), quoted(dir), root.default_features,
+            root.features.iter().map(|f| quoted(f)).collect::<Vec<_>>().join(", ")));
+        source.push_str(&format!("extern crate nif_{index};\n"));
+    }
+    let manifest_path = spec.out_dir.join("Cargo.toml");
+    write_changed(&manifest_path, &manifest)?;
+    // Seed Cargo's library target once. Keep the final source intact during repeated
+    // metadata passes; out_dir is generator-owned, not a custom source extension.
+    if !spec.out_dir.join("src/lib.rs").exists() {
+        write_changed(&spec.out_dir.join("src/lib.rs"), &source)?;
+    }
+    // Clear configuration generated by earlier prepares before resolving again.
+    let config_path = spec.out_dir.join(".cargo/config.toml");
+    write_changed(
+        &config_path,
+        "# Generated by rustler-bundler; do not edit.\n",
+    )?;
+    policy.seed_lock(&spec.out_dir)?;
+    let initial = metadata(spec)?;
+    let runtime = rustler(&initial)?;
+    let (dependency, config) = rustler_dependency(runtime)?;
+    write_changed(&manifest_path, &(manifest + &dependency))?;
+    write_changed(
+        &config_path,
+        &format!("# Generated by rustler-bundler; do not edit.\n{config}"),
+    )?;
+    let final_meta = policy.reconcile(spec, metadata(spec)?)?;
+    if rustler(&final_meta)?.id != runtime.id {
+        return Err("aggregate Rustler dependency did not unify with NIF dependencies".into());
+    }
+    if !final_meta.resolve.nodes.iter().any(|node| {
+        node.id == runtime.id && node.features.iter().any(|f| f == "nif_crate_isolation")
+    }) {
+        return Err("aggregate Rustler runtime did not enable nif_crate_isolation".into());
+    }
+    let ownership = ownership(&final_meta, roots)?;
+    let records = format!("// Generated by rustler-bundler; do not edit.\nrustler_runtime::nif_crate_owners! {{\n{}}}\n", ownership.iter()
+        .map(|p| format!("    {:?} => {:?},\n", p.source, p.owner)).collect::<String>());
+    let ownership_path = spec.out_dir.join("src/ownership.rs");
+    write_changed(&ownership_path, &records)?;
+    source.push_str("include!(\"ownership.rs\");\n");
+    write_changed(&spec.out_dir.join("src/lib.rs"), &source)?;
+    bundle.workspace_inputs = policy.inputs;
+    bundle.entries = roots
+        .iter()
+        .map(|r| {
+            let library = r.library.replace('-', "_");
+            Entry {
+                input: r.input.clone(),
+                init: format!("{library}_nif_init"),
+                library,
+            }
+        })
+        .collect();
+    bundle.ownership = ownership;
+    Ok(bundle)
+}
+fn build(spec: &Spec, bundle: &Bundle) -> Result<PathBuf> {
+    let mut command = cargo(spec)?;
+    command.args(["build", "--locked", "--message-format=json-diagnostic-short"]);
+    if spec.release {
+        command.arg("--release");
+    }
+    if spec.offline {
+        command.arg("--offline");
+    }
+    if let Some(target) = &spec.target {
+        command.args(["--target", target]);
+    }
+    if let Some(dir) = &spec.target_dir {
+        command.arg("--target-dir").arg(dir);
+    }
+    let mut child = command
+        .stdout(Stdio::piped())
+        .stderr(Stdio::inherit())
+        .spawn()?;
+    let mut archive = None;
+    let output = (|| -> Result<()> {
+        for line in io::BufReader::new(child.stdout.take().ok_or("missing Cargo output")?).lines() {
+            let line = line?;
+            match serde_json::from_str::<serde_json::Value>(&line) {
+                Ok(message) if message.is_object() => {
+                    if let Some(path) = bundle_archive(&message, bundle) {
+                        archive = Some(path);
+                    }
+                    println!("{line}");
+                }
+                // Proc macros and compiler wrappers may write arbitrary stdout.
+                // Keep our stdout JSON-only for build-system streaming decoders.
+                _ => eprintln!("{line}"),
+            }
+        }
+        Ok(())
+    })();
+    // Reap Cargo even if reading its output fails.
+    let status = child.wait()?;
+    output?;
+    if !status.success() {
+        return Err(format!("cargo build failed ({status})").into());
+    }
+    let archive = archive.ok_or("cargo produced no bundle archive")?;
+    if !archive.is_file() {
+        return Err("cargo reported a missing bundle archive".into());
+    }
+    Ok(archive)
+}
+
+fn bundle_archive(message: &serde_json::Value, bundle: &Bundle) -> Option<PathBuf> {
+    if message["reason"] != "compiler-artifact"
+        || message["manifest_path"].as_str() != bundle.manifest_path.to_str()
+        || message["target"]["name"] != bundle.library
+        || message["target"]["kind"] != serde_json::json!(["staticlib"])
+    {
+        return None;
+    }
+    message["filenames"]
+        .as_array()?
+        .iter()
+        .filter_map(|f| f.as_str())
+        .find(|f| f.ends_with(".a") || f.ends_with(".lib"))
+        .map(PathBuf::from)
+}
+
