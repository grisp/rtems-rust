+        let meta = Metadata {
+            packages: vec![
+                package("one"),
+                package("two"),
+                package("helper"),
+                package("other"),
+                package("shared"),
+                package("build"),
+                package("dev"),
+                proc_macro,
+            ],
+            resolve: Resolve {
+                root: "one".into(),
+                nodes: vec![
+                    node(
+                        "one",
+                        &[
+                            ("two", None),
+                            ("helper", None),
+                            ("shared", None),
+                            ("build", Some("build")),
+                            ("dev", Some("dev")),
+                            ("macro", None),
+                        ],
+                    ),
+                    node("two", &[("other", None), ("shared", None)]),
+                ],
+            },
+        };
+        let pairs = ownership(&meta, &[root("one"), root("two")]).unwrap();
+        let expected = [
+            ("helper", "one"),
+            ("other", "two"),
+            ("shared", "one"),
+            ("shared", "two"),
+        ]
+        .map(|(source, owner)| Ownership {
+            source: format!("{source}@1.0.0"),
+            owner: format!("{owner}@1.0.0"),
+        });
+        assert_eq!(pairs, expected);
+    }
+    #[test]
+    fn reject_ambiguous_sources_and_non_linkable_nifs() {
+        let mut duplicate = package("helper");
+        duplicate.id = "different-source".into();
+        let mut meta = Metadata {
+            packages: vec![package("one"), package("helper"), duplicate],
+            resolve: Resolve {
+                root: "one".into(),
+                nodes: vec![node("one", &[("helper", None), ("different-source", None)])],
+            },
+        };
+        assert!(ownership(&meta, &[root("one")])
+            .unwrap_err()
+            .to_string()
+            .contains("ambiguous"));
+        meta.packages[0].targets[0].kind = vec!["cdylib".into()];
+        assert!(ownership(&meta, &[root("one")])
+            .unwrap_err()
+            .to_string()
+            .contains("rlib"));
+    }
+    #[test]
+    fn preserve_rustler_source_identity() {
+        let mut runtime = package("rustler");
+        let (path, _) = rustler_dependency(&runtime).unwrap();
+        assert!(path.contains("path = \"/rustler\""));
+        runtime.source =
+            Some("git+https://example.invalid/rustler?branch=support%2Ftest#abcdef".into());
+        let (git, _) = rustler_dependency(&runtime).unwrap();
+        assert!(git.contains("branch = \"support/test\""));
+        assert!(!git.contains("abcdef"));
+        runtime.source = Some("registry+sparse+https://example.invalid/index/".into());
+        let (registry, config) = rustler_dependency(&runtime).unwrap();
+        assert!(registry.contains("registry = \"rustler_bundle_registry\""));
+        assert!(config.contains("sparse+https://example.invalid/index/"));
+    }
+    #[test]
+    fn reject_multiple_or_unpatched_runtime_packages() {
+        let mut runtime = package("rustler");
+        let mut meta = Metadata {
+            packages: vec![package("one"), runtime],
+            resolve: Resolve {
+                root: "one".into(),
+                nodes: vec![node("one", &[("rustler", None)])],
+            },
+        };
+        assert!(rustler(&meta)
+            .err()
+            .unwrap()
+            .to_string()
+            .contains("does not support"));
+        meta.packages[1]
+            .features
+            .insert("nif_crate_isolation".into(), vec![]);
+        assert!(rustler(&meta).is_ok());
+        runtime = package("rustler");
+        runtime.id = "other-runtime".into();
+        meta.packages.push(runtime);
+        meta.resolve.nodes[0] = node("one", &[("rustler", None), ("other-runtime", None)]);
+        assert!(rustler(&meta)
+            .err()
+            .unwrap()
+            .to_string()
+            .contains("exactly one"));
+    }
+}
diff --git a/rustler_bundler/src/workspace.rs b/rustler_bundler/src/workspace.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a62822513ce6671bded8e9c8ee7e48e15f30ad84
--- /dev/null
+++ b/rustler_bundler/src/workspace.rs
@@ -0,0 +1,271 @@
+//! Preserve the owning workspace's settings and committed dependency choices.
+
+use super::{
+    cargo, metadata, metadata_command, read_metadata, Metadata, Result, Root, Spec, Workspace,
+};
+use std::collections::{BTreeMap, BTreeSet};
+use std::fs;
+use std::path::{Path, PathBuf};
+use toml::{Table, Value};
+
+pub(super) struct Policy {
+    pub inputs: Vec<PathBuf>,
+    settings: Table,
+    lock: Option<String>,
+    preferred: BTreeMap<(String, String), BTreeSet<(String, String)>>,
+    owners: BTreeSet<PathBuf>,
+}
+
+fn workspace(spec: &Spec, manifest: &Path) -> Result<Workspace> {
+    if !manifest.is_absolute() {
+        return Err("workspace manifest must be absolute".into());
+    }
+    let mut command = metadata_command(spec)?;
+    command
+        .current_dir(manifest.parent().ok_or("manifest has no parent")?)
+        .args(["--no-deps", "--manifest-path"])
+        .arg(manifest);
+    read_metadata(command)
+}
+
+impl Policy {
+    pub fn load(spec: &Spec, roots: &[Root]) -> Result<Self> {
+        let mut policy = Self {
+            inputs: Vec::new(),
+            settings: Table::new(),
+            lock: None,
+            preferred: BTreeMap::new(),
+            owners: BTreeSet::new(),
+        };
+        let mut workspaces = BTreeSet::new();
+        if let Some(manifest) = &spec.workspace_manifest {
+            let owner = workspace(spec, manifest)?;
+            let root = owner.workspace_root;
+            let manifest = root.join("Cargo.toml");
+            let data: Table = toml::from_str(&fs::read_to_string(&manifest)?)?;
+            for name in ["cargo-features", "profile", "patch", "replace"] {
+                if let Some(value) = data.get(name) {
+                    let mut value = value.clone();
+                    if name == "patch" || name == "replace" {
+                        rebase_paths(&mut value, &root);
+                    }
+                    policy.settings.insert(name.into(), value);
+                }
+            }
+            let resolver = data
+                .get("workspace")
+                .and_then(|v| v.get("resolver"))
+                .or_else(|| data.get("package").and_then(|p| p.get("resolver")))
+                .cloned()
+                .unwrap_or_else(|| {
+                    Value::String(
+                        match data.get("package").and_then(|p| p.get("edition")).and_then(
+                            |edition| {
+                                edition.as_str().or_else(|| {
+                                    edition
+                                        .get("workspace")
+                                        .and_then(Value::as_bool)
+                                        .filter(|v| *v)
+                                        .and_then(|_| {
+                                            data.get("workspace")?
+                                                .get("package")?
+                                                .get("edition")?
+                                                .as_str()
+                                        })
+                                })
+                            },
+                        ) {
+                            Some("2024") => "3",
+                            Some("2021") => "2",
+                            _ => "1",
+                        }
+                        .into(),
+                    )
+                });
+            policy.settings.insert(
+                "workspace".into(),
+                Value::Table([("resolver".into(), resolver)].into_iter().collect()),
+            );
+            policy
+                .owners
+                .extend(owner.packages.into_iter().map(|p| p.manifest_path));
+            policy.read_lock(&root)?;
+            policy.inputs.extend([manifest, root.join("Cargo.lock")]);
+            workspaces.insert(root);
+        }
+        for input in roots {
+            let root = workspace(spec, &input.manifest_path)?.workspace_root;
+            if workspaces.insert(root.clone()) {
+                policy.inputs.push(root.join("Cargo.toml"));
+            }
+        }
+        Ok(policy)
+    }
+
+    fn read_lock(&mut self, root: &Path) -> Result<()> {
+        let path = root.join("Cargo.lock");
+        let text = match fs::read_to_string(&path) {
+            Ok(text) => text,
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(()),
+            Err(e) => return Err(e.into()),
+        };
+        let data: Table = toml::from_str(&text)?;
+        if !matches!(data.get("version").and_then(Value::as_integer), Some(3 | 4)) {
+            return Err(format!("unsupported Cargo.lock version in {}", path.display()).into());
+        }
+        for package in data
+            .get("package")
+            .and_then(Value::as_array)
+            .ok_or("lockfile has no package list")?
+        {
+            if let Some(source) = package.get("source").and_then(Value::as_str) {
+                let name = package["name"].as_str().ok_or("lock package has no name")?;
+                let version = package["version"]
+                    .as_str()
+                    .ok_or("lock package has no version")?;
+                self.preferred
+                    .entry((name.into(), source_family(source)))
+                    .or_default()
+                    .insert((version.into(), source.into()));
+            }
+        }
+        self.lock = Some(text);
+        Ok(())
+    }
+
+    pub fn manifest(&self) -> Result<String> {
+        if self.settings.is_empty() {
+            return Ok(String::new());
+        }
+        // The generated [workspace] header is supplied here when a primary
+        // workspace exists, so its resolver is retained as well as its profiles.
+        Ok(toml::to_string_pretty(&self.settings)?)
+    }
+
+    pub fn has_workspace(&self) -> bool {
+        self.settings.contains_key("workspace")
+    }
+
+    pub fn seed_lock(&self, out: &Path) -> Result<()> {
+        // A coherent application lock seeds resolution. Library locks cannot be
+        // merged: their dependency edges may pin incompatible resolutions even
+        // when the manifests have compatible requirements.
+        if let Some(lock) = &self.lock {
+            super::write_changed(&out.join("Cargo.lock"), lock)?;
+        }
+        Ok(())
+    }
+
+    pub fn reconcile(&self, spec: &Spec, mut meta: Metadata) -> Result<Metadata> {
+        let mut attempted = BTreeSet::new();
+        loop {
+            let mut reachable = self
+                .owners
+                .iter()
+                .flat_map(|manifest| {
+                    meta.packages
+                        .iter()
+                        .filter(move |p| &p.manifest_path == manifest)
+                        .map(|p| p.id.clone())
+                })
+                .collect::<BTreeSet<_>>();
+            let mut queue = reachable.iter().cloned().collect::<Vec<_>>();
+            while let Some(id) = queue.pop() {
+                if let Some(node) = meta.resolve.nodes.iter().find(|n| n.id == id) {
+                    for dep in &node.deps {
+                        if dep
+                            .dep_kinds
+                            .iter()
+                            .any(|k| k.kind.as_deref() != Some("dev"))
+                            && reachable.insert(dep.pkg.clone())
+                        {
+                            queue.push(dep.pkg.clone());
+                        }
+                    }
+                }
+            }
+            let conflict = meta
+                .packages
+                .iter()
+                .filter(|p| reachable.contains(&p.id))
+                .find_map(|p| {
+                    let source = p.source.as_ref()?;
+                    let versions = self
+                        .preferred
+                        .get(&(p.name.clone(), source_family(source)))?;
+                    (!versions.contains(&(p.version.clone(), source.clone())))
+                        .then_some((p, versions))
+                });
+            let Some((package, versions)) = conflict else {
+                return Ok(meta);
+            };
+            if !attempted.insert(package.id.clone()) {
+                return Err(format!(
+                    "cannot preserve owning Cargo.lock: conflicting input lock choices for {}; update the owning Cargo.lock",
+                    package.name
+                )
+                .into());
+            }
+            let locked = fs::read(spec.out_dir.join("Cargo.lock"))?;
+            let mut resolved = false;
+            for (version, source) in versions {
+                let precise = if source.starts_with("git+") {
+                    source
+                        .rsplit_once('#')
+                        .ok_or("git lock source has no revision")?
+                        .1
+                } else {
+                    version
+                };
+                let mut command = cargo(spec)?;
+                command.args([
+                    "update",
+                    "--package",
+                    &format!("{}@{}", package.name, package.version),
+                    "--precise",
+                    precise,
+                ]);
+                if spec.offline {
+                    command.arg("--offline");
+                }
+                let output = command.output()?;
+                if output.status.success() {
+                    resolved = true;
+                    break;
+                }
+                fs::write(spec.out_dir.join("Cargo.lock"), &locked)?;
+            }
+            if !resolved {
+                return Err(format!("cannot preserve owning Cargo.lock: {} is locked to {:?}, but the combined NIF graph requires {}; update compatible requirements and the owning lockfile",
+                    package.name, versions, package.version).into());
+            }
+            meta = metadata(spec)?;
+        }
+    }
+}
+
+fn rebase_paths(value: &mut Value, root: &Path) {
+    if let Some(table) = value.as_table_mut() {
+        if let Some(Value::String(path)) = table.get_mut("path") {
+            if Path::new(path).is_relative() {
+                *path = root.join(&*path).to_string_lossy().into_owned();
+            }
+        }
+        for (_, child) in table.iter_mut() {
+            rebase_paths(child, root);
+        }
+    }
+}
+
+// Git lock sources include the resolved revision; compare choices within the
+// same repository/reference so an updated revision cannot escape lock checks.
+fn source_family(source: &str) -> String {
+    if source.starts_with("git+") {
+        source
+            .rsplit_once('#')
+            .map_or(source, |(repository, _)| repository)
+            .into()
+    } else {
+        source.into()
+    }
+}
