diff --git a/rustler/src/codegen_runtime.rs b/rustler/src/codegen_runtime.rs
index 703ae8f15ae7f350e198bbd8e3cc4adc117c655c..09c3f5fe5781072f15eb9b2a25aa67ba46c475bb 100644
--- a/rustler/src/codegen_runtime.rs
+++ b/rustler/src/codegen_runtime.rs
@@ -10,6 +10,61 @@ use crate::{Encoder, Env, OwnedBinary, Term};
 // Re-export of inventory
 pub use inventory;
 
+// Ownership is selected in the runtime crate, so host proc-macro feature
+// unification cannot accidentally enable it in a default-mode target crate.
+#[cfg(feature = "nif_crate_isolation")]
+pub struct CrateNif {
+    pub owner: &'static str,
+    pub nif: crate::Nif,
+}
+#[cfg(feature = "nif_crate_isolation")]
+inventory::collect!(CrateNif);
+
+impl crate::Nif {
+    #[doc(hidden)]
+    #[cfg(not(feature = "nif_crate_isolation"))]
+    pub const fn with_crate(self, _owner: &'static str) -> Self {
+        self
+    }
+
+    #[doc(hidden)]
+    #[cfg(feature = "nif_crate_isolation")]
+    pub const fn with_crate(self, owner: &'static str) -> CrateNif {
+        CrateNif { owner, nif: self }
+    }
+}
+
+/// A helper crate's registrations belong to the specified NIF crate.
+/// Normally emitted by `rustler_bundler` through `nif_crate_owners!`.
+#[cfg(feature = "nif_crate_isolation")]
+pub struct CrateOwnership {
+    pub source: &'static str,
+    pub owner: &'static str,
+}
+#[cfg(feature = "nif_crate_isolation")]
+inventory::collect!(CrateOwnership);
+
+#[cfg(feature = "nif_crate_isolation")]
+pub(crate) fn owns_crate(owner: &str, source: &str) -> bool {
+    source == owner
+        || inventory::iter::<CrateOwnership>
+            .into_iter()
+            .any(|entry| entry.source == source && entry.owner == owner)
+}
+
+#[cfg(feature = "nif_crate_isolation")]
+pub fn nifs_for_crate(owner: &str) -> impl Iterator<Item = &'static crate::Nif> + '_ {
+    inventory::iter::<CrateNif>
+        .into_iter()
+        .filter(move |entry| owns_crate(owner, entry.owner))
+        .map(|entry| &entry.nif)
+}
+
+#[cfg(not(feature = "nif_crate_isolation"))]
+pub fn nifs_for_crate(_owner: &str) -> impl Iterator<Item = &'static crate::Nif> {
+    inventory::iter::<crate::Nif>.into_iter()
+}
+
 // Re-export of resource registration
 pub use crate::resource::Registration as ResourceRegistration;
 
