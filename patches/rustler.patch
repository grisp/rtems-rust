 #[doc(hidden)]
 pub mod codegen_runtime;
 
+/// Assign registrations from helper crates to their enclosing NIF crates.
+///
+/// Requires `nif_crate_isolation`. Keys are `crate_name@package_version`.
+/// Emit this once in the aggregate crate; NIF dependencies need no changes.
+#[cfg(feature = "nif_crate_isolation")]
+#[macro_export]
+macro_rules! nif_crate_owners {
+    ($($source:literal => $owner:literal),* $(,)?) => {
+        $(
+            $crate::codegen_runtime::inventory::submit! {
+                $crate::codegen_runtime::CrateOwnership {
+                    source: $source,
+                    owner: $owner,
+                }
+            }
+        )*
+    };
+}
+
 mod alloc;
 pub use crate::alloc::EnifAllocator;
 
