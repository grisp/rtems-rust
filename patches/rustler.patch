+#[derive(Clone, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Root {
+    #[serde(default)]
+    input: Option<String>,
+    manifest_path: PathBuf,
+    package: String,
+    library: String,
+    #[serde(default)]
+    features: Vec<String>,
+    #[serde(default = "default_true")]
+    default_features: bool,
+}
