#!/usr/bin/env python3
"""Run a Rust package build with SDK-controlled Cargo/compiler settings."""

import argparse
import os


def environment(inherited, home, target, jobs, rustc=None):
    env = {name: value for name, value in inherited.items()
           if not name.startswith(("CARGO_", "RUST", "GRISP_RUST"))}
    env.update(CARGO_HOME=home, CARGO_TARGET_DIR=target,
               CARGO_BUILD_JOBS=str(jobs), CARGO_NET_OFFLINE="true")
    if rustc:
        env["RUSTC"] = rustc
    return env


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--cargo-home", required=True)
    parser.add_argument("--target-dir", required=True)
    parser.add_argument("--jobs", type=int, required=True)
    parser.add_argument("--rustc")
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    if args.jobs < 1:
        parser.error("jobs must be positive")
    command = args.command
    if command[:1] == ["--"]:
        command = command[1:]
    if not command:
        parser.error("a build command is required")
    os.execvpe(command[0], command, environment(os.environ, args.cargo_home,
        args.target_dir, args.jobs, args.rustc))


if __name__ == "__main__":
    main()
