#!/usr/bin/env python3
"""Snapshot local source trees without committing or touching their real indexes."""

import argparse
import hashlib
import io
import json
import os
from pathlib import Path
import subprocess
import tarfile
import tempfile

ROOT = Path(__file__).resolve().parents[1]


def git(repo, *args, **kw):
    return subprocess.check_output(["git", "-C", str(repo), *args], **kw)


def verify(repo, item, patches):
    with tempfile.TemporaryDirectory(prefix="rtems-rust-patch-") as tmp:
        tmp = Path(tmp)
        env = {**os.environ, "GIT_INDEX_FILE": str(tmp / "index")}
        git(repo, "read-tree", item["base"], env=env)
        for patch in patches:
            git(repo, "apply", "--cached", str(patch), env=env)
        tree = git(repo, "write-tree", env=env).decode().strip()
        if tree != item["tree"]:
            raise ValueError(f"{patches}: complete tree identity differs")
        paths = git(repo, "diff", "--name-only", item["base"], tree).decode().splitlines()
        present = [p for p in paths if subprocess.run(
            ["git", "-C", str(repo), "cat-file", "-e", item["base"] + ":" + p],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0]
        source = tmp / "source"
        source.mkdir()
        if present:
            with tarfile.open(fileobj=io.BytesIO(git(repo, "archive", item["base"], "--", *present))) as archive:
                archive.extractall(source, filter="data")
        for _ in range(2):
            for patch in patches:
                subprocess.run(["git", "apply", "--check", str(patch)], cwd=source, check=True)
                subprocess.run(["git", "apply", str(patch)], cwd=source, check=True)
            for patch in reversed(patches):
                subprocess.run(["git", "apply", "--reverse", "--check", str(patch)], cwd=source, check=True)
                subprocess.run(["git", "apply", "--reverse", str(patch)], cwd=source, check=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--workspace", required=True, type=Path)
    parser.add_argument("--source", action="append", default=[], metavar="NAME=PATH",
                        help="snapshot an adapted tree using the original repository's objects")
    parser.add_argument("--refresh", action="store_true")
    parser.add_argument("--component", action="append", default=[],
                        choices=["rust", "libc", "inventory", "rustler"])
    args = parser.parse_args()
    overrides = dict(s.split("=", 1) for s in args.source)
    path = ROOT / "sources.json"
    manifest = json.loads(path.read_text())
    for name, item in manifest["components"].items():
        if args.component and name not in args.component:
            continue
        repo = args.workspace / name
        patch = ROOT / "patches" / (name + ".patch")
        backports = [ROOT / "patches" / b["patch"] for b in item.get("backports", [])]
        for entry, backport in zip(item.get("backports", []), backports):
            if hashlib.sha256(backport.read_bytes()).hexdigest() != entry["patch_sha256"]:
                raise ValueError(f"{backport}: patch checksum differs")
        if args.refresh:
            commit = git(repo, "rev-parse", "HEAD").decode().strip()
            parent = git(repo, "rev-parse", "HEAD^").decode().strip()
            if parent != item["base"] and name not in overrides:
                parser.error(f"{name}: feature baseline differs from the pinned release; supply --source {name}=<ported-tree>")
            with tempfile.TemporaryDirectory(prefix="rtems-rust-index-") as tmp:
                env = {**os.environ, "GIT_INDEX_FILE": str(Path(tmp) / "index")}
                source = Path(overrides.get(name, repo)).resolve()
                git_dir = git(repo, "rev-parse", "--absolute-git-dir").decode().strip()
                env.update(GIT_DIR=git_dir, GIT_WORK_TREE=str(source))
                git(repo, "read-tree", item["base"], env=env)
                git(source, "add", "-A", env=env)
                tree = git(repo, "write-tree", env=env).decode().strip()
                # Keep separately attributed upstream backports out of the
                # feature commit's patch while pinning the complete final tree.
                for backport in reversed(backports):
                    git(repo, "apply", "--cached", "--reverse", str(backport), env=env)
                feature_tree = git(repo, "write-tree", env=env).decode().strip()
            # Reuse the feature commit's mail header, author, date and full message.
            header = git(repo, "show", "-s", "--format=email", commit)
            delta = git(repo, "diff", "--binary", "--full-index", item["base"], feature_tree)
            patch.write_bytes(header + b"\n---\n\n" + delta)
            item.update(commit=commit, tree=tree,
                        patch_sha256=hashlib.sha256(patch.read_bytes()).hexdigest())
        elif git(repo, "rev-parse", "HEAD").decode().strip() != item["commit"]:
            raise ValueError(f"{name}: local feature commit differs from the snapshot")
        if hashlib.sha256(patch.read_bytes()).hexdigest() != item["patch_sha256"]:
            raise ValueError(f"{name}: patch checksum differs")
        verify(repo, item, [patch, *backports])
        print(f"{name}: complete tree and two forward/reverse cycles passed")
    if args.refresh:
        path.write_text(json.dumps(manifest, indent=2) + "\n")


if __name__ == "__main__":
    main()
