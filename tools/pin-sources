#!/usr/bin/env python3
"""Refresh declared upstream archive hashes and RSB inputs, without building."""

import argparse
import hashlib
import json
from pathlib import Path
import urllib.request

ROOT = Path(__file__).resolve().parents[1]
HOSTS = ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu",
         "x86_64-apple-darwin", "aarch64-apple-darwin"]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--rust-source", required=True, type=Path)
    parser.add_argument("--cache", required=True, type=Path)
    args = parser.parse_args()
    manifest = json.loads((ROOT / "sources.json").read_text())
    # Maintenance runs use Python 3.11+; the SDK build helpers do not need tomllib.
    import tomllib
    lock_path = ROOT / "config/rust/nif.Cargo.lock"
    packages = [p for p in tomllib.loads(lock_path.read_text())["package"] if "source" in p]
    manifest["nif_lock_sha256"] = hashlib.sha256(lock_path.read_bytes()).hexdigest()
    (ROOT / "config/rust/nif-packages.json").write_text(json.dumps(packages, indent=2) + "\n")
    nif_sources = ["# Registry sources pinned by nif.Cargo.lock."]
    nif_prep = ["%prep"]
    for i, package in enumerate(packages):
        name, version = package["name"], package["version"]
        archive = name + "-" + version + ".crate"
        nif_sources += [f'%source set nif-crate-{i} --rsb-file={archive} https://static.crates.io/crates/{name}/{archive}',
                        f'%hash sha256 {archive} {package["checksum"]}']
        nif_prep.append(f'%source setup nif-crate-{i} -q -c -n rust-nif-vendor/{name}-{version} -s 1')
    (ROOT / "config/rust/nif-sources.cfg").write_text("\n".join(nif_sources) + "\n")
    (ROOT / "config/rust/nif-vendor-prep.cfg").write_text("\n".join(nif_prep) + "\n")
    args.cache.mkdir(parents=True, exist_ok=True)
    lines = ["# Generated by tools/pin-sources; all downloads belong to RSB."]
    for name, item in manifest["components"].items():
        if name != "rust":
            cached = args.cache / item["archive"]
            if not cached.exists():
                with urllib.request.urlopen(item["source_url"], timeout=60) as response:
                    cached.write_bytes(response.read())
            digest = hashlib.sha256(cached.read_bytes()).hexdigest()
            if item.get("source_sha256", digest) != digest:
                raise ValueError(f"{name}: upstream archive checksum changed")
            item["source_sha256"] = digest
        lines += [f'%source set {name} --rsb-file={item["archive"]} {item["source_url"]}',
                  f'%hash sha256 {item["archive"]} {item["source_sha256"]}',
                  f'%patch add {name} file://%{{rust_project}}/patches/{name}.patch',
                  f'%hash sha256 {name}.patch {item["patch_sha256"]}']
        for backport in item.get("backports", []):
            lines += [f'%patch add {name} file://%{{rust_project}}/patches/{backport["patch"]}',
                      f'%hash sha256 {backport["patch"]} {backport["patch_sha256"]}']
    (ROOT / "config/rust/sources.cfg").write_text("\n".join(lines) + "\n")
    versions = ["# Generated immutable component identities."]
    for name, item in manifest["components"].items():
        versions += [f'%define rust_{name}_base {item["base"]}',
                     f'%define rust_{name}_version {item["version"]}']
    versions.append('%define rust_version %{rust_rust_version}')
    (ROOT / "config/rust/versions.cfg").write_text("\n".join(versions) + "\n")
    stage0 = dict(line.split("=", 1) for line in (args.rust_source / "src/stage0").read_text().splitlines()
                  if "=" in line and not line.startswith("#"))
    manifest["stage0"] = {}
    for host in HOSTS:
        entries = []
        for component in ("rustc", "rust-std", "cargo"):
            archive = f'{component}-{stage0["compiler_version"]}-{host}.tar.xz'
            path = f'dist/{stage0["compiler_date"]}/{archive}'
            entries.append({"component": component, "archive": archive,
                            "url": stage0["dist_server"] + "/" + path,
                            "sha256": stage0[path]})
        manifest["stage0"][host] = entries
        cfg = [f'# Bootstrap inputs for {host}, from Rust src/stage0.',
               f'%define rust_stage0_version {stage0["compiler_version"]}']
        for item in entries:
            cfg += [f'%source set stage0-{item["component"]} --rsb-file={item["archive"]} {item["url"]}',
                    f'%hash sha256 {item["archive"]} {item["sha256"]}']
        (ROOT / f"config/rust/stage0-{host}.cfg").write_text("\n".join(cfg) + "\n")
    (ROOT / "sources.json").write_text(json.dumps(manifest, indent=2) + "\n")


if __name__ == "__main__":
    main()
